{
    "name": "fromholdio/silverstripe-externalurlfield",
    "description": "Provides SilverStripe with a DBField and FormField for handling external URLs.",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "keywords": [
        "silverstripe",
        "url",
        "link",
        "form",
        "field"
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/userforms": "^7",
        "jakeasmith/http_build_url": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3"
    },
    "authors": [
        {
            "name": "Jeremy Shipman",
            "homepage": "https://github.com/jedateach",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "BurnBright\\ExternalURLField\\": "src/",
            "BurnBright\\ExternalURLField\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev"
}
